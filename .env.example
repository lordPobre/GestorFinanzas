# Copia esto a .env para desarrollo local. NUNCA subas el .env al repo.
# En Railway estos valores van en la pestana Variables del servicio.

# --- Obligatorias en produccion ---
SECRET_KEY=
DEBUG=True

# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Sin esta variable la app cae a SQLite local, que es lo que quieres en dev.
DATABASE_URL=

# Desactiva sslmode=require. Necesario con el Postgres interno de Railway,
# que se alcanza por la red privada y puede rechazar el handshake TLS.
DB_SSL=0

# Dominios. Con el dominio .up.railway.app no hace falta tocarlas: settings.py
# agrega solo lo que Railway publica en RAILWAY_PUBLIC_DOMAIN.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Para que los enlaces de los correos salgan absolutos y con https.
SITE_URL=http://localhost:8000

# --- Correo (finanzas/correo.py) ---
# Sale por API HTTP, no por SMTP. Elige un proveedor:
PROVEEDOR_CORREO=resend
RESEND_API_KEY=
CORREO_FROM=Rekon <no-responder@tudominio.cl>

# Alternativa con Mailgun:
# PROVEEDOR_CORREO=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE=https://api.mailgun.net

# --- Acceso con Google (finanzas/google_login.py) ---
# Si faltan, el boton de Google no se dibuja y el acceso normal sigue igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Fotos de perfil en Cloudflare R2 (finanzas/almacenamiento.py) ---
# Si faltan, las fotos van al disco local (MEDIA_ROOT). En un contenedor eso
# significa que se pierden en cada redespliegue: en Railway son obligatorias.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# --- Analisis con IA (finanzas/ia.py) ---
# Si falta, el analisis con IA se desactiva y quedan solo los numeros del
# motor determinístico.
ANTHROPIC_API_KEY=

# --- Opcionales ---
# Carpeta persistente para el log de seguridad. Sin esto, en produccion el
# log va solo a la consola (el disco del contenedor es efimero).
LOG_DIR=

# Carpeta destino de 'manage.py respaldar'. Solo aplica con SQLite.
RESPALDOS_DIR=

# Clave de los campos de texto cifrados (finanzas/cifrado.py). HOY NO SE USA:
# TextoCifrado no esta aplicado a ningun modelo. Si algun dia lo conectas,
# generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# y guardala aparte de la base: si se pierde, los datos cifrados no se recuperan.
FIELD_ENCRYPTION_KEY=

# Monitoreo de errores con Sentry. Sin esta variable no se activa nada y la
# app funciona igual; con ella, cada excepcion no controlada llega a tu
# panel. send_default_pii queda en False: los informes no llevan correo ni
# IP de nadie.
SENTRY_DSN=

# Nombre del entorno que aparece en los informes de Sentry.
ENTORNO=produccion
